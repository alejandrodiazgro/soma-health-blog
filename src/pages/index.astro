---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ArticleCard from "../components/ArticleCard.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const blogRoot = import.meta.env.BASE_URL.replace(/\/$/, "") || "/";
const link = (slug: string) => `${blogRoot}/${slug}`;
---
<BaseLayout
  title="SOMA Salud"
  description="Guías para abrir, organizar y digitalizar una consulta médica privada en México: expediente clínico, COFEPRIS, receta electrónica, agenda e inteligencia artificial."
  keywords={["software para consultorio médico", "expediente clínico electrónico", "cómo iniciar consulta privada en México", "software médico México"]}
>
  <section class="hero shell">
    <div class="hero-copy">
      <p class="eyebrow">Biblioteca para profesionales de la salud</p>
      <h1>Tu consulta privada,<br /><span>mejor organizada.</span></h1>
      <p class="lead">Guías claras para abrir, administrar y digitalizar tu práctica médica en México. Desde el primer trámite hasta el seguimiento de cada paciente.</p>
      <div class="hero-actions">
        <a class="button" href="#rutas">Comenzar por una guía <span aria-hidden="true">↓</span></a>
        <a class="button secondary" href="https://www.somahealth.com.mx">Conocer SOMA <span aria-hidden="true">↗</span></a>
      </div>
      <p class="hero-note"><span aria-hidden="true">●</span> Contenido práctico, actualizado y enfocado en México.</p>
    </div>
    <aside class="topic-panel glass" aria-label="Ruta recomendada para organizar la consulta">
      <div class="panel-top"><span class="mini-logo" aria-hidden="true"><svg viewBox="0 0 32 32"><path d="M5 17h5l3-6 4 11 3-5h7"></path></svg></span><span>Ruta SOMA</span><small>5 etapas</small></div>
      <ol>
        <li><span>01</span><div><strong>Abre tu consulta</strong><small>Modelo, espacio y presupuesto</small></div></li>
        <li><span>02</span><div><strong>Cumple los requisitos</strong><small>COFEPRIS y documentación</small></div></li>
        <li><span>03</span><div><strong>Organiza el expediente</strong><small>Historia, notas y privacidad</small></div></li>
        <li><span>04</span><div><strong>Digitaliza tu operación</strong><small>Agenda, receta y seguimiento</small></div></li>
        <li><span>05</span><div><strong>Haz crecer tu práctica</strong><small>Pacientes y productividad</small></div></li>
      </ol>
      <a href={link("como-iniciar-consulta-privada-mexico")}>Ver la guía completa <span aria-hidden="true">→</span></a>
    </aside>
  </section>

  <section class="proof shell" aria-label="Principios editoriales">
    <article><strong>México</strong><span>Normativa y contexto local</span></article>
    <article><strong>Sin ruido</strong><span>Una respuesta clara por página</span></article>
    <article><strong>Para médicos</strong><span>Decisiones de la práctica real</span></article>
  </section>

  <section class="routes shell" id="rutas">
    <header class="section-head">
      <div><p class="eyebrow">Rutas de aprendizaje</p><h2>Empieza por lo que necesitas resolver hoy.</h2></div>
      <p>Cada ruta reúne una guía principal y artículos relacionados. Así encuentras la respuesta sin navegar entre contenido repetido.</p>
    </header>
    <div class="route-grid">
      <a class="route-card route-main" href={link("como-iniciar-consulta-privada-mexico")}>
        <span class="route-number">01</span><small>Consulta privada</small>
        <h3>Abre tu consultorio con una ruta clara.</h3>
        <p>Modelo, requisitos, espacio, impuestos, documentación y primer paciente.</p>
        <strong>Explorar la ruta <span aria-hidden="true">→</span></strong>
      </a>
      <a class="route-card glass" href={link("expediente-clinico-electronico-mexico")}>
        <span class="route-number">02</span><small>Expediente clínico</small>
        <h3>Documenta con orden desde la primera consulta.</h3>
        <p>Historia clínica, notas, NOM-004, privacidad y digitalización.</p>
        <strong>Explorar la ruta <span aria-hidden="true">→</span></strong>
      </a>
      <a class="route-card glass" href={link("software-para-consultorio-medico")}>
        <span class="route-number">03</span><small>Software médico</small>
        <h3>Elige tecnología que se adapte a tu práctica.</h3>
        <p>Agenda, expediente, receta, seguridad, exportación y costos.</p>
        <strong>Explorar la ruta <span aria-hidden="true">→</span></strong>
      </a>
      <a class="route-card glass" href={link("inteligencia-artificial-para-medicos")}>
        <span class="route-number">04</span><small>IA y productividad</small>
        <h3>Recupera tiempo sin perder criterio clínico.</h3>
        <p>Nota por voz, revisión humana, privacidad y usos responsables.</p>
        <strong>Explorar la ruta <span aria-hidden="true">→</span></strong>
      </a>
    </div>
  </section>

  <section class="profiles shell">
    <div class="profile-copy">
      <p class="eyebrow">Según tu momento profesional</p>
      <h2>La misma meta. Un punto de partida diferente.</h2>
    </div>
    <div class="profile-grid">
      <a class="profile glass" href={link("consulta-privada-medico-recien-egresado")}><span>MG</span><div><strong>Médico recién egresado</strong><p>Empieza con alcance claro, inversión controlada y un proceso seguro.</p></div><b aria-hidden="true">→</b></a>
      <a class="profile glass" href={link("iniciar-consulta-privada-especialista")}><span>ESP</span><div><strong>Especialista</strong><p>Convierte tu experiencia en servicios, seguimiento y referencias bien organizadas.</p></div><b aria-hidden="true">→</b></a>
    </div>
  </section>

  <section class="articles shell" id="articulos">
    <header class="section-head">
      <div><p class="eyebrow">Biblioteca SOMA</p><h2>Guías para tomar la siguiente decisión.</h2></div>
      <p>Contenido educativo sobre operación clínica, tecnología y normativa. Revisa siempre las fuentes y requisitos aplicables a tu caso.</p>
    </header>
    <div class="article-grid">
      {posts.map((post) => (
        <ArticleCard slug={post.id} title={post.data.title} description={post.data.description} category={post.data.category} publishedAt={post.data.publishedAt} featured={post.data.featured} />
      ))}
    </div>
  </section>

  <section class="cta shell glass">
    <div><p class="eyebrow">Del conocimiento a la práctica</p><h2>Organiza agenda, expediente y recetas con SOMA.</h2><p>Una experiencia clínica más simple para ti y tus pacientes.</p></div>
    <a class="button" href="https://www.somahealth.com.mx">Conocer SOMA <span aria-hidden="true">↗</span></a>
  </section>
</BaseLayout>

<style>
  .hero { min-height: 690px; display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(350px, .75fr); align-items: center; gap: clamp(34px, 6vw, 78px); padding-block: 76px 62px; }
  .hero-copy { max-width: 700px; }
  h1 { max-width: 690px; margin: 9px 0 20px; color: var(--ink); font-size: clamp(40px, 5.4vw, 66px); line-height: 1; letter-spacing: -.055em; }
  h1 span { color: var(--brand); }
  .lead { max-width: 630px; margin: 0; color: var(--muted); font-size: 18px; line-height: 1.65; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 28px; }
  .hero-note { margin: 26px 0 0; color: var(--brand); font-size: 13px; font-weight: 600; }
  .hero-note span { margin-right: 7px; color: var(--accent); }
  .topic-panel { padding: 20px; border-radius: 28px; }
  .panel-top { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 9px; padding-bottom: 15px; border-bottom: 1px solid var(--line); font-size: 13px; font-weight: 600; }
  .panel-top small { color: var(--muted); font-weight: 500; }
  .mini-logo { display: grid; place-items: center; width: 29px; height: 29px; border-radius: 9px; background: var(--brand); color: white; }
  .mini-logo svg { width: 21px; fill: none; stroke: currentColor; stroke-width: 2.5; stroke-linecap: round; stroke-linejoin: round; }
  .topic-panel ol { list-style: none; padding: 5px 0; margin: 0; }
  .topic-panel li { display: grid; grid-template-columns: 30px 1fr; gap: 10px; align-items: center; padding: 13px 3px; border-bottom: 1px solid var(--line); }
  .topic-panel li > span { color: var(--brand); font-size: 11px; font-weight: 700; }
  .topic-panel li strong, .topic-panel li small { display: block; }
  .topic-panel li strong { font-size: 14px; font-weight: 600; }
  .topic-panel li small { margin-top: 1px; color: var(--muted); font-size: 11px; }
  .topic-panel > a { display: flex; justify-content: space-between; padding: 14px 3px 2px; color: var(--brand); font-size: 13px; font-weight: 600; text-decoration: none; }
  .proof { display: grid; grid-template-columns: repeat(3, 1fr); margin-bottom: 110px; border-block: 1px solid var(--line); }
  .proof article { padding: 22px 26px; border-right: 1px solid var(--line); }
  .proof article:last-child { border-right: 0; }
  .proof strong, .proof span { display: block; }
  .proof strong { color: var(--brand); font-size: 14px; }
  .proof span { margin-top: 3px; color: var(--muted); font-size: 13px; }
  .routes, .articles { padding-block: 26px 74px; }
  .section-head { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(280px, .65fr); align-items: end; gap: 50px; margin-bottom: 30px; }
  .section-head h2, .profiles h2, .cta h2 { max-width: 730px; margin: 6px 0 0; font-size: clamp(34px, 4.7vw, 56px); line-height: 1.03; letter-spacing: -.045em; }
  .section-head > p { margin: 0; color: var(--muted); }
  .route-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }
  .route-card { min-height: 330px; display: flex; flex-direction: column; padding: 28px; border-radius: 24px; text-decoration: none; transition: transform .18s ease, box-shadow .18s ease; }
  .route-card:hover { transform: translateY(-2px); box-shadow: 0 22px 48px rgba(16,40,48,.14); }
  .route-main { background: linear-gradient(150deg, rgba(19,86,80,.96), rgba(14,63,59,.91)); box-shadow: var(--glass-shadow); color: white; }
  .route-number { align-self: flex-end; display: grid; place-items: center; width: 42px; height: 42px; border: 1px solid rgba(255,255,255,.9); border-radius: 50%; background: rgba(255,255,255,.65); color: var(--brand); font-size: 11px; font-weight: 700; }
  .route-card small { margin-top: auto; color: var(--brand); font-size: 12px; font-weight: 600; letter-spacing: .05em; text-transform: uppercase; }
  .route-main small { color: #bfe4dc; }
  .route-card h3 { max-width: 500px; margin: 9px 0 10px; font-size: clamp(25px, 3vw, 38px); }
  .route-card p { max-width: 520px; margin: 0; color: var(--muted); }
  .route-main p { color: rgba(255,255,255,.74); }
  .route-card > strong { margin-top: 26px; color: var(--brand); font-size: 13px; }
  .route-main > strong { color: white; }
  .profiles { display: grid; grid-template-columns: .85fr 1.15fr; gap: 55px; align-items: start; padding-block: 60px 110px; }
  .profile-grid { display: grid; gap: 14px; }
  .profile { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 16px; padding: 22px; border-radius: 22px; text-decoration: none; }
  .profile > span { display: grid; place-items: center; width: 48px; height: 48px; border-radius: 50%; background: var(--brand-soft); color: var(--brand); font-size: 11px; font-weight: 700; }
  .profile strong { font-size: 17px; }
  .profile p { margin: 3px 0 0; color: var(--muted); font-size: 13px; line-height: 1.45; }
  .profile b { color: var(--brand); }
  .article-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }
  .cta { display: flex; align-items: center; justify-content: space-between; gap: 32px; margin-top: 42px; padding: 38px; border-radius: 28px; }
  .cta h2 { max-width: 700px; }
  .cta p:last-child { margin: 12px 0 0; color: var(--muted); }
  @media (max-width: 820px) {
    .hero { min-height: auto; grid-template-columns: 1fr; gap: 34px; padding-block: 68px 50px; }
    h1 { font-size: clamp(35px, 10vw, 53px); }
    .lead { font-size: 16px; }
    .proof { grid-template-columns: 1fr; margin-bottom: 75px; }
    .proof article { border-right: 0; border-bottom: 1px solid var(--line); }
    .proof article:last-child { border-bottom: 0; }
    .section-head, .profiles { grid-template-columns: 1fr; gap: 24px; }
    .route-grid, .article-grid { grid-template-columns: 1fr; }
    .route-card { min-height: 300px; padding: 23px; }
    .profiles { padding-block: 35px 85px; }
    .cta { align-items: flex-start; flex-direction: column; padding: 26px; }
  }
</style>
