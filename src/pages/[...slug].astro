---
import { getCollection, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const date = new Intl.DateTimeFormat("es-MX", { day: "numeric", month: "long", year: "numeric" }).format(post.data.publishedAt);
---
<BaseLayout
  title={post.data.title}
  description={post.data.description}
  type="article"
  publishedAt={post.data.publishedAt}
  updatedAt={post.data.updatedAt}
  keywords={post.data.keywords}
>
  <article class="article shell">
    <header>
      <a class="back" href="/blog">← Todos los artículos</a>
      <p class="eyebrow">{post.data.category}</p>
      <h1>{post.data.title}</h1>
      <p class="dek">{post.data.description}</p>
      <div class="byline"><span>{post.data.author}</span><time datetime={post.data.publishedAt.toISOString()}>{date}</time></div>
    </header>
    <div class="article-layout">
      <aside class="toc glass">
        <strong>En este artículo</strong>
        <nav aria-label="Contenido del artículo">
          {headings.filter((h) => h.depth === 2).map((heading) => <a href={`#${heading.slug}`}>{heading.text}</a>)}
        </nav>
      </aside>
      <div class="prose glass"><Content /></div>
    </div>
  </article>
</BaseLayout>

<style>
  .article { padding-block: 70px 30px; }
  .article > header { max-width: 930px; margin: 0 auto 45px; text-align: center; }
  .back { display: inline-block; margin-bottom: 34px; color: var(--muted); text-decoration: none; font-weight: 650; }
  h1 { margin: 14px 0 22px; font-size: clamp(2.5rem, 6vw, 5.3rem); line-height: 1.02; letter-spacing: -.05em; text-wrap: balance; }
  .dek { max-width: 760px; margin: 0 auto; color: var(--muted); font-size: 1.2rem; }
  .byline { margin-top: 24px; display: flex; justify-content: center; gap: 18px; color: var(--muted); font-size: .86rem; }
  .article-layout { display: grid; grid-template-columns: 240px minmax(0, 760px); justify-content: center; gap: 24px; align-items: start; }
  .toc { position: sticky; top: 24px; border-radius: 20px; padding: 20px; }
  .toc nav { margin-top: 12px; display: grid; gap: 8px; }
  .toc a { color: var(--muted); font-size: .86rem; line-height: 1.35; text-decoration: none; }
  .toc a:hover { color: var(--brand); }
  .prose { border-radius: 28px; padding: clamp(25px, 5vw, 58px); font-size: 1.05rem; }
  .prose :global(h2) { margin: 2.4em 0 .7em; font-size: 1.85rem; line-height: 1.15; letter-spacing: -.025em; }
  .prose :global(h2:first-child) { margin-top: 0; }
  .prose :global(h3) { margin-top: 1.8em; }
  .prose :global(p), .prose :global(li) { color: #334552; }
  .prose :global(a) { color: var(--brand); font-weight: 650; }
  .prose :global(blockquote) { margin: 2em 0; padding: 18px 22px; border-left: 4px solid var(--accent); border-radius: 0 14px 14px 0; background: rgba(88,181,128,.1); }
  @media (max-width: 850px) { .article-layout { grid-template-columns: 1fr; } .toc { position: static; } }
</style>
