---
interface Props {
  slug: string;
  title: string;
  description: string;
  category: string;
  publishedAt: Date;
  featured?: boolean;
}
const { slug, title, description, category, publishedAt, featured = false } = Astro.props;
const date = new Intl.DateTimeFormat("es-MX", { day: "numeric", month: "long", year: "numeric" }).format(publishedAt);
const blogRoot = import.meta.env.BASE_URL.replace(/\/$/, "") || "/";
const href = `${blogRoot}/${slug}`;
---
<article class:list={["article-card", "glass", { featured }]}>
  <p class="meta"><span>{category}</span><time datetime={publishedAt.toISOString()}>{date}</time></p>
  <h2><a href={href}>{title}</a></h2>
  <p>{description}</p>
  <a class="read" href={href} aria-label={`Leer ${title}`}>Leer guía <span aria-hidden="true">→</span></a>
</article>

<style>
  .article-card { min-height: 300px; display: flex; flex-direction: column; padding: 28px; border-radius: 24px; transition: transform .18s ease, box-shadow .18s ease, background .18s ease; }
  .article-card:hover { transform: translateY(-2px); background: rgba(255,255,255,.82); box-shadow: 0 22px 48px rgba(16,40,48,.14); }
  .article-card.featured { grid-column: span 2; min-height: 340px; background: linear-gradient(145deg, rgba(19,86,80,.95), rgba(14,63,59,.9)); color: white; border-color: rgba(255,255,255,.28); }
  .meta { display: flex; justify-content: space-between; gap: 12px; margin: 0; color: var(--muted); font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: .06em; }
  .featured .meta { color: rgba(255,255,255,.72); }
  .meta span { color: var(--brand); }
  .featured .meta span { color: #bfe7dc; }
  h2 { max-width: 750px; margin: 24px 0 12px; font-size: clamp(24px, 2.5vw, 36px); line-height: 1.1; text-wrap: balance; }
  h2 a { text-decoration: none; }
  article > p:not(.meta) { max-width: 720px; margin: 0; color: var(--muted); }
  .featured > p:not(.meta) { color: rgba(255,255,255,.78); }
  .read { margin-top: auto; padding-top: 28px; color: var(--brand); font-size: 13px; font-weight: 600; text-decoration: none; }
  .featured .read { color: white; }
  @media (max-width: 720px) { .article-card.featured { grid-column: span 1; } }
</style>
