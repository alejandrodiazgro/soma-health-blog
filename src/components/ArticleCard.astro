---
interface Props {
  slug: string;
  title: string;
  description: string;
  category: string;
  publishedAt: Date;
  featured?: boolean;
}
const { slug, title, description, category, publishedAt, featured = false } = Astro.props;
const date = new Intl.DateTimeFormat("es-MX", { day: "numeric", month: "long", year: "numeric" }).format(publishedAt);
---
<article class:list={["article-card", "glass", { featured }]}>
  <p class="meta"><span>{category}</span><time datetime={publishedAt.toISOString()}>{date}</time></p>
  <h2><a href={`/blog/${slug}`}>{title}</a></h2>
  <p>{description}</p>
  <a class="read" href={`/blog/${slug}`} aria-label={`Leer ${title}`}>Leer artículo <span aria-hidden="true">→</span></a>
</article>

<style>
  .article-card { border-radius: 24px; padding: 26px; min-height: 290px; display: flex; flex-direction: column; }
  .article-card.featured { grid-column: span 2; background: linear-gradient(145deg, rgba(19,86,80,.94), rgba(14,63,59,.86)); color: white; border-color: rgba(255,255,255,.28); }
  .meta { display: flex; justify-content: space-between; gap: 12px; color: var(--muted); font-size: .76rem; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; }
  .featured .meta { color: rgba(255,255,255,.72); }
  .meta span { color: var(--brand); }
  .featured .meta span { color: #bfe7dc; }
  h2 { font-size: clamp(1.45rem, 2vw, 2rem); line-height: 1.15; margin: 20px 0 12px; text-wrap: balance; }
  h2 a { text-decoration: none; }
  article > p:not(.meta) { color: var(--muted); margin: 0; }
  .featured > p:not(.meta) { color: rgba(255,255,255,.78); }
  .read { margin-top: auto; padding-top: 24px; color: var(--brand); font-weight: 750; text-decoration: none; }
  .featured .read { color: white; }
  @media (max-width: 720px) { .article-card.featured { grid-column: span 1; } }
</style>
